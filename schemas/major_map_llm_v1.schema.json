{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scheduler.j-vaught.chatgpt.site/schemas/major_map_llm_v1.schema.json",
  "title": "LLM-extracted UofSC major map",
  "description": "Evidence-backed representation of one official major-map PDF.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "map_id",
    "source",
    "program",
    "plan",
    "requirements_outside_plan",
    "footnotes",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "major-map-llm-v1"
    },
    "map_id": {
      "type": "string",
      "pattern": "^map_[0-9a-f]{16}$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "program": {
      "$ref": "#/$defs/program"
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "requirements_outside_plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "footnotes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/footnote"
      }
    },
    "review": {
      "$ref": "#/$defs/review"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "creditRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "maximum": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "quote"],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": ["string", "null"],
          "description": "Human-readable location such as semester-one table or footnote 4."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pdf_path",
        "pdf_url",
        "sha256",
        "page_count",
        "catalog_year"
      ],
      "properties": {
        "pdf_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "pdf_url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        },
        "catalog_year": {
          "type": "string",
          "pattern": "^20[0-9]{2}-20[0-9]{2}$"
        }
      }
    },
    "concentration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "explicit", "evidence"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "explicit": {
          "type": "boolean",
          "description": "True only when the PDF explicitly identifies this concentration or pathway."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "degree_name",
        "degree_abbreviation",
        "college",
        "department",
        "total_credits",
        "concentrations",
        "evidence"
      ],
      "properties": {
        "major": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "degree_name": {
          "$ref": "#/$defs/nullableString"
        },
        "degree_abbreviation": {
          "$ref": "#/$defs/nullableString"
        },
        "college": {
          "$ref": "#/$defs/nullableString"
        },
        "department": {
          "$ref": "#/$defs/nullableString"
        },
        "total_credits": {
          "$ref": "#/$defs/creditRange"
        },
        "concentrations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/concentration"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "subject", "number"],
      "properties": {
        "type": {
          "const": "course"
        },
        "subject": {
          "type": "string",
          "pattern": "^[A-Z]{2,5}$"
        },
        "number": {
          "type": "string",
          "pattern": "^[0-9]{3}[A-Z]?$"
        }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code", "label"],
      "properties": {
        "type": {
          "const": "attribute"
        },
        "code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "elective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "subject_filters", "number_filter"],
      "properties": {
        "type": {
          "const": "elective"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "subject_filters": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2,5}$"
          }
        },
        "number_filter": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text", "reason"],
      "properties": {
        "type": {
          "const": "unresolved"
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "logicalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {
          "enum": ["all_of", "any_of", "one_of"]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "nOfRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "minimum", "maximum", "items"],
      "properties": {
        "type": {
          "const": "n_of"
        },
        "minimum": {
          "type": "integer",
          "minimum": 0
        },
        "maximum": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "rule": {
      "oneOf": [
        {
          "$ref": "#/$defs/course"
        },
        {
          "$ref": "#/$defs/attribute"
        },
        {
          "$ref": "#/$defs/elective"
        },
        {
          "$ref": "#/$defs/unresolved"
        },
        {
          "$ref": "#/$defs/logicalRule"
        },
        {
          "$ref": "#/$defs/nOfRule"
        }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "label",
        "source_text",
        "credits",
        "critical",
        "minimum_grade",
        "requirement_codes",
        "rule",
        "evidence",
        "confidence",
        "review_flags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(semester-[1-9][0-9]*|outside)-requirement-[1-9][0-9]*$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "credits": {
          "$ref": "#/$defs/creditRange"
        },
        "critical": {
          "type": ["boolean", "null"]
        },
        "minimum_grade": {
          "$ref": "#/$defs/nullableString"
        },
        "requirement_codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "rule": {
          "$ref": "#/$defs/rule"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_flags": {
          "type": "array",
          "items": {
            "enum": [
              "ambiguous_logic",
              "course_code_uncertain",
              "credit_value_uncertain",
              "footnote_dependency",
              "missing_context",
              "possible_ocr_error",
              "program_metadata_uncertain",
              "unresolved_elective_definition"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "semester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "label", "academic_year", "term", "credits", "requirements"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "academic_year": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "term": {
          "enum": ["fall", "spring", "summer", "unspecified"]
        },
        "credits": {
          "$ref": "#/$defs/creditRange"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "semesters"],
      "properties": {
        "format": {
          "enum": ["four_year", "accelerated", "transfer", "other"]
        },
        "semesters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semester"
          }
        }
      }
    },
    "footnote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marker", "text", "applies_to", "evidence"],
      "properties": {
        "marker": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "applies_to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "reviewIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message", "evidence"],
      "properties": {
        "severity": {
          "enum": ["info", "warning", "error"]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence", "issues", "summary"],
      "properties": {
        "status": {
          "enum": ["ready", "needs_review", "blocked"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewIssue"
          }
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
